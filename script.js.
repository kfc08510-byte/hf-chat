  databaseURL: "https://fh-chat-da54b-default-rtdb.firebaseio.com"
};

// تشغيل Firebase
if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const db = firebase.database();

// توليد معرف عشوائي للمستخدم الحالي
const UID = "User_" + Math.floor(Math.random() * 1000);
let mediaRec, chunks = [];

// 1. نظام الدخول المحمي (إخفاء الرمز 0709)
document.getElementById('login-btn').onclick = () => {
    const inputPass = document.getElementById('pass-field').value;
    // الكود المشفر للرمز 0709 هو "MDcwOQ=="
    const secureHash = "MDcwOQ=="; 

    if (btoa(inputPass) === secureHash) {
        document.getElementById('login-overlay').style.display = 'none';
        startApp();
    } else { 
        alert("الرمز خطأ! حاول مرة أخرى."); 
    }
};

// 2. تفعيل زر الإعدادات (Dark Mode)
document.getElementById('theme-btn').onclick = () => {
    document.body.classList.toggle('dark-mode');
};

// 3. تشغيل وظائف التطبيق بعد الدخول
function startApp() {
    // استلام الرسائل بشكل مباشر
    db.ref("chat").on("child_added", (snapshot) => {
        const data = snapshot.val();
        const flow = document.getElementById('chat-flow');
        const div = document.createElement('div');
        div.className = `bubble ${data.u === UID ? 'me' : 'other'}`;
        
        if(data.t === 'txt') {
            div.innerText = data.v;
        } else if(data.t === 'img') {
            div.innerHTML = `<img src="${data.v}" style="width:100%; border-radius:10px;">`;
        } else if(data.t === 'aud') {
            div.innerHTML = `<audio controls src="${data.v}" style="width:200px"></audio>`;
        }
        
        flow.appendChild(div);
        flow.scrollTop = flow.scrollHeight; // النزول لآخر رسالة تلقائياً
    });

    // إرسال رسالة نصية
    document.getElementById('send-btn').onclick = () => {
        const inp = document.getElementById('main-input');
        if(inp.value.trim()) { 
            db.ref("chat").push({ u: UID, t: 'txt', v: inp.value }); 
            inp.value = ''; 
        }
    };

    // إرسال صورة
    document.getElementById('img-trigger').onclick = () => document.getElementById('file-hidden').click();
    document.getElementById('file-hidden').onchange = (e) => {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (ev) => db.ref("chat").push({ u: UID, t: 'img', v: ev.target.result });
            reader.readAsDataURL(file);
        }
    };

    // تسجيل وإرسال فويس (حل مشكلة المايكروفون)
    document.getElementById('mic-control').onclick = async () => {
        if (!mediaRec || mediaRec.state === "inactive") {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRec = new MediaRecorder(stream);
                chunks = [];
                mediaRec.ondataavailable = e => chunks.push(e.data);
                mediaRec.onstop = () => {
                    const blob = new Blob(chunks, { type: 'audio/webm' });
                    const r = new FileReader();
                    r.onload = ev => db.ref("chat").push({ u: UID, t: 'aud', v: ev.target.result });
                    r.readAsDataURL(blob);
                };
                mediaRec.start();
                document.getElementById('mic-control').style.color = "red";
                document.getElementById('rec-indicator').style.display = "block";
            } catch(err) {
                alert("برجاء السماح بالوصول للميكروفون.");
            }
        } else {
            mediaRec.stop();
            document.getElementById('mic-control').style.color = "";
            document.getElementById('rec-indicator').style.display = "none";
        }
    };
}
